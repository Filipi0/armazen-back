generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserAdmin {
  id         Int      @id @default(autoincrement()) 
  email      String   @unique
  password   String
  name       String
  createdAt  DateTime @default(now())

  resetToken String?  

  products   Product[]
  stockMovements StockMovement[] 
  users User[] // Relacionamento reverso com usuários
}

model User {
  id        Int    @id @default(autoincrement()) 
  idAdmin   Int
  email     String @unique
  password  String
  name      String  
  createdAt DateTime @default(now())

  resetToken String? 

  products  Product[]

  userAdmin UserAdmin @relation(fields: [idAdmin], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
}

model Product {
  id             Int      @id @default(autoincrement()) 
  idAdmin        Int?     
  idUser         Int?     
  itemType       String   
  supplier       String?  
  name           String   
  quantity       Int      
  unit           String   
  expirationDate DateTime?  
  createdAt      DateTime @default(now()) 

  userAdmin      UserAdmin? @relation(fields: [idAdmin], references: [id], onDelete: Cascade)
  user          User?      @relation(fields: [idUser], references: [id], onDelete: Cascade)

  stockMovements StockMovement[]
}

enum MovementType {
  entrada
  saida
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  productId   Int
  userId      Int?
  adminId     Int?
  quantity    Int
  movementType MovementType
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAdmin   UserAdmin? @relation(fields: [adminId], references: [id], onDelete: Cascade)
}
