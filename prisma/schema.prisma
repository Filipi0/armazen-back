generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserAdmin {
  id         Int      @id @default(autoincrement()) 
  email      String   @unique
  password   String
  name       String
  createdAt  DateTime @default(now())

  resetToken String?  // Campo para armazenar o token de recuperação de senha (opcional)

  products   Product[]
}


model User {
  id        Int    @id @default(autoincrement()) 
  idAdmin   Int
  email     String @unique
  password  String
  name      String  // 🔹 Novo campo para armazenar o nome do usuário
  createdAt DateTime @default(now())

  resetToken String? // Permite a recuperação de senha para usuários normais

  products  Product[]
}

model Product {
  id             Int      @id @default(autoincrement()) 
  idAdmin        Int?     // Agora pode ser NULL se o produto for cadastrado por um usuário comum
  idUser         Int?     // Novo campo para identificar o usuário que cadastrou o produto
  itemType       String   
  supplier       String?  
  name           String   
  quantity       Int      
  unit           String   
  expirationDate DateTime?  
  createdAt      DateTime @default(now()) 

  // 🔹 Relacionamento correto com UserAdmin (Produto pode ser cadastrado por um Admin)
  userAdmin      UserAdmin? @relation(fields: [idAdmin], references: [id], onDelete: Cascade)

  // 🔹 Relacionamento com User (Produto pode ser cadastrado por um Usuário comum)
  user          User?      @relation(fields: [idUser], references: [id], onDelete: Cascade)
}
